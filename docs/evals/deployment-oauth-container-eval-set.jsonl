{"id":"deploy-oauth-001","title":"API 容器 DNS","scope":"production-container","command":"getent hosts oauth2.googleapis.com","expected":{"exit_code":0,"address_present":true},"failure":"dns_unresolved","secrets":"none"}
{"id":"deploy-oauth-002","title":"API 容器 TCP/TLS 443","scope":"production-container","command":"python -c 'import socket; socket.create_connection((\"oauth2.googleapis.com\",443),8)'","expected":{"exit_code":0,"connectable":true},"failure":"timeout_or_refused","secrets":"none"}
{"id":"deploy-oauth-003","title":"API 容器 HTTPS 证书","scope":"production-container","command":"python -c 'import ssl,socket; s=ssl.create_default_context().wrap_socket(socket.create_connection((\"oauth2.googleapis.com\",443),8),server_hostname=\"oauth2.googleapis.com\"); print(s.version())'","expected":{"exit_code":0,"certificate_verified":true,"hostname_match":true},"failure":"tls_or_ca_error","secrets":"none"}
{"id":"deploy-oauth-004","title":"API 容器代理继承","scope":"production-container","command":"python -c 'import os; print({k:bool(os.getenv(k)) for k in (\"HTTP_PROXY\",\"HTTPS_PROXY\",\"ALL_PROXY\")})'","expected":{"proxy_config_documented":true,"secret_values_not_printed":true},"failure":"proxy_missing_or_unexpected","secrets":"proxy values must not be printed"}
{"id":"deploy-oauth-005","title":"NetworkPolicy/安全组出网","scope":"production-cluster","command":"kubectl exec deploy/video2md-api -- python -c 'import socket; socket.create_connection((\"oauth2.googleapis.com\",443),8)'","expected":{"exit_code":0,"egress_443_allowed":true},"failure":"policy_denied","secrets":"none"}
{"id":"deploy-oauth-006","title":"生产运行镜像包含诊断改动","scope":"production-cluster","command":"kubectl exec deploy/video2md-api -- python -c 'import video2md.api as a; print(hasattr(a,\"_google_oauth_timeout_s\"))'","expected":{"exit_code":0,"value":"True"},"failure":"stale_image","secrets":"none"}
{"id":"deploy-oauth-007","title":"换票诊断日志出现且脱敏","scope":"production-observability","command":"kubectl exec deploy/video2md-api -- grep '/auth/google/token' logs/api-requests.jsonl","expected":{"path_present":true,"error_type_present":true,"no_forbidden_fields":["code","state","client_secret","id_token","email"]},"failure":"missing_or_leaky_log","secrets":"log output must be redacted before sharing"}
