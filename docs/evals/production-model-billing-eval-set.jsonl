{"id": "prod-billing-001", "title": "真实登录后显式输入生产视频链接", "scope": "production-browser", "mode": "user-authorized-billable", "setup": "使用已授权的生产测试身份完成 Google 登录", "actions": ["打开新建转换", "清空任何自动填充内容", "显式输入批准的公开视频 URL"], "pass": {"authenticated": true, "url_entered_by_test": true, "clipboard_value_not_implicitly_submitted": true}, "fail_categories": ["login_failed", "form_unavailable", "implicit_clipboard_submission"], "authorization": {"real_billing_preapproved": true, "applies_to": "本项目生产测试", "reconfirm_each_run": false}, "secrets": "不记录邮箱、OAuth code/state/id_token、MFA 或 API Key"}
{"id": "prod-billing-002", "title": "生产计费任务创建必须可观测", "scope": "production-browser+api", "mode": "user-authorized-billable", "actions": ["点击立即开始转换排队", "读取任务队列"], "pass": {"submission_feedback_visible": true, "run_id_present": true, "run_owner_is_current_user": true, "status_in": ["created", "queued", "running", "done", "partial", "error"]}, "fail_categories": ["silent_submission_failure", "missing_run_id", "owner_isolation_failure"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "报告只记录脱敏 run_id、状态和错误类别"}
{"id": "prod-billing-003", "title": "LLM 与 GPU 用量进入本人计费账本", "scope": "production-api+observability", "mode": "user-authorized-billable", "actions": ["等待任务终态", "读取 GET /cost 和 run usage"], "pass": {"terminal_status_in": ["done", "partial", "error"], "usage_present": true, "llm_tokens_nonnegative": true, "gpu_seconds_nonnegative": true, "cost_usd_nonnegative": true, "monthly_rollup_includes_run": true}, "fail_categories": ["task_never_terminal", "usage_missing", "cost_not_settled", "rollup_mismatch"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "不记录模型密钥、完整 prompt、完整转录或用户凭据"}
{"id": "prod-billing-004", "title": "计费幂等与预算防重复扣费", "scope": "production-api", "mode": "user-authorized-billable", "actions": ["对同一规范化 URL 重试一次", "再次读取任务与成本"], "pass": {"dedup_observed": true, "duplicate_usage_absent": true, "duplicate_cost_absent": true, "budget_gate_enforced": true}, "fail_categories": ["duplicate_bill", "dedup_bypass", "budget_gate_missing"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "仅记录差值和脱敏 run_id"}
{"id": "prod-billing-005", "title": "生产教材产物闭环", "scope": "production-browser+api", "mode": "user-authorized-billable", "actions": ["打开完成任务", "进入阅读器", "检查教材与媒体", "验证交付包状态"], "pass": {"book_visible_in_library": true, "reader_loads": true, "markdown_nonempty": true, "media_references_safe": true, "bundle_state_explicit": true}, "fail_categories": ["library_missing_run", "reader_error", "empty_note", "unsafe_media_reference", "bundle_state_ambiguous"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "产物摘要可记录；不复制完整受版权保护的转录内容"}
{"id": "prod-billing-006", "title": "生产提交失败不得静默关闭表单", "scope": "frontend+production-browser", "mode": "deterministic-and-live", "actions": ["令 POST /runs 返回受控错误", "点击立即开始转换排队"], "pass": {"error_visible": true, "modal_remains_open": true, "entered_url_preserved": true, "success_toast_absent": true}, "fail_categories": ["silent_submission_failure", "modal_closed_on_failure", "input_lost", "false_success"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "受控错误不得包含 token 或上游凭据"}
{"id": "prod-billing-007", "title": "生产视频来源解析门禁", "scope": "production-container", "mode": "live-egress", "actions": ["用批准的短视频分别探测启用的来源", "记录解析状态和错误类别"], "pass": {"at_least_one_approved_source_resolves": true, "bounded_timeout": true}, "fail_categories": ["youtube_bot_challenge", "bilibili_http_412", "proxy_unreachable", "all_sources_blocked"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "cookies 和代理凭据不得进入证据"}
{"id": "prod-billing-008", "title": "任务与提交审计持久化", "scope": "production-database", "mode": "live-readonly-evidence", "actions": ["提交成功后按脱敏 run_id 查询 v2md_runs", "查询对应提交审计记录"], "pass": {"run_row_present": true, "submit_log_present": true, "owner_matches_session": true}, "fail_categories": ["run_not_persisted", "submit_log_missing", "owner_mismatch"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "只记录行存在性、状态和脱敏 run_id"}
{"id": "prod-billing-009", "title": "零费用不得伪装成计费通过", "scope": "production-gate", "mode": "evidence-evaluation", "actions": ["检查 run、模型调用、usage、cost 与月度汇总"], "pass": {"run_id_present": true, "model_called": true, "positive_usage_present": true, "cost_settled": true, "monthly_rollup_includes_run": true}, "fail_categories": ["zero_cost_without_model_call", "usage_missing", "cost_unsettled", "false_green"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "证据只包含汇总用量和成本，不含 prompt 或密钥"}
{"id": "prod-billing-010", "title": "生产复测必须从退出并重新登录开始", "scope": "production-browser", "mode": "live-authentication", "actions": ["退出已有会话", "确认进入登录页", "完成 Google OAuth 并回跳"], "pass": {"logout_observed": true, "oauth_login_succeeded": true, "authenticated_page_visible": true}, "fail_categories": ["logout_not_observed", "oauth_login_failed", "authenticated_page_missing"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "不记录邮箱、OAuth 参数、ID token 或账号选择细节"}
{"id": "prod-billing-011", "title": "视频链接必须由测试者在可见前端显式输入", "scope": "production-browser", "mode": "live-ui", "actions": ["进入任务页", "清空输入框", "输入批准的受控 MP4 URL", "读取输入框值"], "pass": {"url_entered_explicitly": true, "visible_value_matches_approved_url": true}, "fail_categories": ["implicit_submission", "url_value_mismatch", "input_not_visible"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "仅记录公开受控测试资源 URL"}
{"id": "prod-billing-012", "title": "一次提交必须只新增一个任务", "scope": "production-browser+api", "mode": "live-task-creation", "actions": ["记录提交前任务数", "提交一次", "记录提交后任务数和 run_id"], "pass": {"task_count_delta": 1, "run_id_present": true, "historical_retry_false": true}, "fail_categories": ["task_not_created", "duplicate_task_created", "historical_task_reused", "run_id_missing"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "只记录计数和脱敏 run_id"}
{"id": "prod-billing-013", "title": "新任务必须出现真实处理中阶段", "scope": "production-browser", "mode": "live-stage-observation", "actions": ["观察新任务卡", "等待至少一个 active 阶段"], "pass": {"running_stage_observed": true, "observed_stage_nonempty": true}, "fail_categories": ["no_stage_progress", "queued_forever", "false_running_state"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "阶段名可记录，不记录内容数据"}
{"id": "prod-billing-014", "title": "模型计费验收只接受成功终态", "scope": "production-gate", "mode": "evidence-evaluation", "actions": ["等待终态", "核对任务状态"], "pass": {"terminal_status_in": ["done", "partial"]}, "fail_categories": ["error_terminal", "task_never_terminal", "false_green"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "只记录状态和脱敏 run_id"}
{"id": "prod-billing-015", "title": "成功任务必须新增一本非空教材", "scope": "production-browser+api", "mode": "artifact-regression", "actions": ["记录提交前教材数", "等待任务成功", "记录提交后教材数", "读取 Markdown 摘要"], "pass": {"book_count_delta": 1, "book_visible": true, "markdown_nonempty": true}, "fail_categories": ["zero_artifact_delta", "library_missing_run", "empty_markdown"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "不复制完整转录或受版权保护正文"}
{"id": "prod-billing-016", "title": "run 级模型用量与费用必须对用户可见", "scope": "production-browser+api", "mode": "billing-visibility", "actions": ["打开计费明细", "定位本次 run", "核对 token、GPU 秒数与费用"], "pass": {"usage_visible": true, "cost_visible": true, "llm_tokens_positive": true, "cost_settled": true}, "fail_categories": ["usage_hidden", "cost_hidden", "zero_model_tokens", "cost_unsettled"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "只记录汇总 token、GPU 秒数和成本"}
{"id": "prod-billing-017", "title": "可用模型与明确的实际成本口径是前置门禁", "scope": "production-preflight", "mode": "live-readonly-evidence", "actions": ["探测配置模型可用性", "读取生产单价回显"], "pass": {"model_channel_usable": true, "llm_input_price_positive": true, "llm_output_price_positive": true, "gpu_cost_policy": "positive-metered-or-explicit-approved-free-zero", "cached_input_accounted": true}, "fail_categories": ["model_channel_disabled", "llm_input_price_zero", "llm_output_price_zero", "unexplained_zero_gpu_price", "cached_tokens_mispriced"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "不记录 API Key；只记录模型名、状态类别和单价"}
{"id": "prod-billing-018", "title": "失败任务必须暴露 run_id、失败阶段和错误摘要", "scope": "production-browser", "mode": "failure-diagnostics", "actions": ["制造或观察失败任务", "检查失败卡与详情页"], "pass": {"run_id_visible": true, "failure_stage_visible": true, "failure_reason_visible": true, "retry_action_available": true}, "fail_categories": ["run_id_hidden", "failure_stage_hidden", "failure_reason_hidden", "opaque_failure_card"], "authorization": {"real_billing_preapproved": true, "reconfirm_each_run": false}, "secrets": "错误摘要必须脱敏，不得包含 token、cookies、代理或模型密钥"}
