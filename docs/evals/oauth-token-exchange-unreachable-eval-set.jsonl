{"id":"token-exchange-003","title":"OAuth 专用出口实际被 httpx 使用","scope":"production-config+runtime","probe":"oauth_http_client_route","pass":{"configured_route_used":true,"retired_17898_absent":true,"download_proxy_not_reused":true},"fail_categories":["proxy_ignored","proxy_unreachable","wrong_proxy_protocol","ambiguous_route","retired_proxy_present"],"forbidden_values":["127.0.0.1:17898",":17898"],"secrets":"代理地址只记录 host 分类，不记录凭据"}
