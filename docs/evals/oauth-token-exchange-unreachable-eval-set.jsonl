{"id":"token-exchange-005","title":"换票失败快速失败并正确分类","scope":"api-contract","probe":"callback_network_failure","pass":{"http_status":302,"frontend_error_present":true,"error_category_in":["connect_error","connect_timeout","tls_error","oauth_http_error"],"elapsed_ms_present":true,"bounded_by_configured_timeout":true},"fail_categories":["callback_hung","generic_error_only","missing_latency","wrong_status"],"secrets":"must_not_print"}
