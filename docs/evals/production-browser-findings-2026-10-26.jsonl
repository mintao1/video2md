{"id":"pb-001","title":"登录、刷新、退出与受保护路由","scope":"production-browser","probe":"browser_auth_session_logout","input":{"scenario":"authorized Google OAuth browser flow","sample":{"kind":"synthetic","callback_success":true,"fragment_cleared":true,"library_visible":true,"reload_authenticated":true,"logout_cleared":true,"protected_redirect":true,"redirect_preserved":true}},"expectedOutput":{"checks":["auth_session_logout"],"criteria":["Google 回调成功且 URL fragment 清理","/library 可见且刷新后仍保持会话","退出清理网站会话并回品牌首页","退出后受保护路由重定向并保留站内 redirect"]},"counterexamples":[{"name":"callback-failed","check":"auth_session_logout","path":"/callback_success","value":false},{"name":"fragment-retained","check":"auth_session_logout","path":"/fragment_cleared","value":false},{"name":"reload-loses-session","check":"auth_session_logout","path":"/reload_authenticated","value":false},{"name":"logout-leaves-session","check":"auth_session_logout","path":"/logout_cleared","value":false},{"name":"redirect-dropped","check":"auth_session_logout","path":"/redirect_preserved","value":false}],"metadata":{"title":"认证链路可回归且退出彻底","area":"auth","source":"production-browser-observation-2026-10-26","historical_outcome":"pass","offline_can_close_production":false,"regressions":["frontend/web/tests/login-production.integration.test.mjs","frontend/web/tests/colab-tenant.integration.test.mjs"],"production_evidence_required":["真实 Google 回调、刷新后的 /library、退出后受保护路由；不得记录 email、code、state、token 或 MFA。"],"privacy":"不保存账号、授权码、Cookie、Token 或 API Key。"}}
{"id":"pb-002","title":"预检、GPU 池与额度一致性","scope":"production-http+browser","probe":"preflight_and_quota","input":{"scenario":"authenticated preflight and profile quota","sample":{"kind":"synthetic","preflight":{"ok":true,"checks":{"gpu_pool":{"ok":true}}},"quota":{"conversion_remaining_h":2.0,"storage_remaining_gb":1.0,"ai_hours_used":2.0,"ai_hours_total":4.0,"storage_gb_used":1.0,"storage_gb_total":2.0,"profile_quota_text":"2/4 小时；1/2 GB"},"quota_consistent":true,"cpu_fallback":false}},"expectedOutput":{"checks":["preflight_gpu_quota"],"criteria":["/preflight ok=true","gpu_pool 可用，或服务明确声明并验证 CPU fallback","额度字段为有限非负数字且 API 与个人中心一致","不能把 gpu_pool=false 或 0/0 额度标记为可提交新任务","采集证据同时保留 /quota 原始字段与 Profile 派生展示"]},"counterexamples":[{"name":"gpu-pool-down","check":"preflight_gpu_quota","path":"/preflight/checks/gpu_pool/ok","value":false},{"name":"quota-zero-zero","check":"preflight_gpu_quota","path":"/quota/conversion_remaining_h","value":0.0},{"name":"quota-nan-string","check":"preflight_gpu_quota","path":"/quota/storage_remaining_gb","value":"NaN"},{"name":"api-ui-mismatch","check":"preflight_gpu_quota","path":"/quota_consistent","value":false},{"name":"raw-quota-omitted","check":"preflight_gpu_quota","path":"/quota/ai_hours_total","value":null},{"name":"profile-display-omitted","check":"preflight_gpu_quota","path":"/quota/profile_quota_text","value":""}],"metadata":{"title":"算力和额度必须先通过才允许真实任务","area":"preflight-quota","source":"production-browser-observation-2026-10-26","historical_outcome":"blocked","offline_can_close_production":false,"regressions":["backend/tests/test_api_contract.py::test_preflight_anonymous_redacted","backend/tests/test_production_readiness_gate.py::test_repository_contracts"],"production_evidence_required":["同一 release 的 /preflight、/quota、Profile 展示和 CPU/GPU 路由证据；当前 gpu_pool=false 与 0/0 必须保持 blocked。"],"privacy":"只记录状态和数值，不记录凭据。"}}
{"id":"pb-003","title":"任务历史计数与失败诊断一致性","scope":"production-browser","probe":"task_history_reconciliation","input":{"scenario":"authenticated task queue history","sample":{"kind":"synthetic","total":13,"active":0,"done":5,"failed":8,"rows":[{"status":"done","stage":"deliver","reason":"","retry":false},{"status":"done","stage":"deliver","reason":"","retry":false},{"status":"done","stage":"deliver","reason":"","retry":false},{"status":"done","stage":"deliver","reason":"","retry":false},{"status":"done","stage":"deliver","reason":"","retry":false},{"status":"failed","stage":"download","reason":"source unavailable","retry":true},{"status":"failed","stage":"download","reason":"source unavailable","retry":true},{"status":"failed","stage":"download","reason":"source unavailable","retry":true},{"status":"failed","stage":"download","reason":"source unavailable","retry":true},{"status":"failed","stage":"download","reason":"source unavailable","retry":true},{"status":"failed","stage":"download","reason":"source unavailable","retry":true},{"status":"failed","stage":"download","reason":"source unavailable","retry":true},{"status":"failed","stage":"download","reason":"source unavailable","retry":true}],"filters_reconcile":true,"history_preserved":true}},"expectedOutput":{"checks":["task_history_reconciliation"],"criteria":["总数等于 active+done+failed","完成/失败筛选计数与行数据一致","每个失败任务保留 stage、reason 和 retry 能力","刷新后历史失败不消失、不被误标为成功"]},"counterexamples":[{"name":"count-mismatch","check":"task_history_reconciliation","path":"/failed","value":7},{"name":"missing-failure-reason","check":"task_history_reconciliation","path":"/rows/5/reason","value":""},{"name":"missing-retry","check":"task_history_reconciliation","path":"/rows/5/retry","value":null},{"name":"history-dropped","check":"task_history_reconciliation","path":"/history_preserved","value":false}],"metadata":{"title":"任务历史不能静默丢失失败事实","area":"tasks","source":"production-browser-observation-2026-10-26","historical_outcome":"pass_with_failur