{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "node --test tests/*.integration.test.mjs",
    "test:regression": "node --test tests/*.regression.test.mjs",
    "test:e2e": "playwright test --project=e2e",
    "screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "pinia": "2.3.1",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  }
}
