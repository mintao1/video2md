# ============================================================================
# 本文件只放【本机非机密配置】模板。复制为 .env 后按需修改。
#
# ⭐ 所有 key/凭证统一 SSOT：~/.config/dify-zcode.env（dify_kit 基座契约）：
#   DIFY_BASE_URL=http://localhost:8090/v1          # 本地基座（~/dify/docker，nginx 8090）
#   DIFY_APP_API_KEY=app-…                          # Workflow「视频转文档」应用 Key
#   DIFY_DATASET_API_KEY=dataset-…                  # 知识库 API Key（可选，不上传可缺）
#   DIFY_DATASET_ID=<uuid>                          # 可选；缺省自动按名建「视频知识库」
#   DIFY_ADMIN_EMAIL / DIFY_ADMIN_PW                # 控制台管理（导入工作流/配置 tracing 用）
#
# ⚠ 不要在本 .env 放任何 key —— 历史上占位符 app-xxxx 曾盖过真 key 导致 401。
#    项目 .env 里的 key 读取链已于 2026-09-20 拆除。
# ============================================================================

# ---- dify_kit 基座位置（默认 ~/Desktop/开发项目/dify_kit）----
# DIFY_KIT_HOME=

# ---- 管线代理（YouTube 等境外源下载走这里；国内站由代码层强制直连，见 _subprocess_env；
#       Colab/Kaggle 等 GPU 平台流量已随算力池迁出本进程，在 gpu_router 项目里配）----
# HTTP_PROXY=http://127.0.0.1:17898
# HTTPS_PROXY=http://127.0.0.1:17898
# ALL_PROXY=http://127.0.0.1:17898
# NO_PROXY=localhost,127.0.0.1,::1,*.local,*.douyin.com,*.bilibili.com,*.bilivideo.com
# http_proxy/http_proxy/all_proxy/no_proxy 同上小写一套

# ---- 管线行为开关 ----
# GPU 算力池（独立项目 ~/Desktop/开发项目/gpu_router，2026-09-21 起 Colab 直联已抽离）：
#   cd ~/Desktop/开发项目/gpu_router && .venv/bin/python -m gpu_router   # 起池子
#   （配该项目 gpu_router.json，模板见其 gpu_router.example.json）
# 三个负载指向池子，平台间选举/熔断/故障转移全由池子负责：
# V2MD_REMOTE=http://127.0.0.1:9700        # 转录（ASR）走池子
# V2MD_CLIPS_REMOTE=http://127.0.0.1:9700  # 剪节段走池子
# V2MD_OCR_REMOTE=http://127.0.0.1:9700    # OCR 也走池子（不设则保持本地 macOS Vision）
# V2MD_CLIPS_SOURCE=remote   # 剪辑源片由远端直连 CDN 下载（省本地上行代理流量）
# V2MD_CB_THRESHOLD=3        # 阶段熔断：连续同因失败条数上限
# V2MD_PORT=8790             # serve 端口
# 池子观测/开关：curl 127.0.0.1:9700/status · POST /providers/{name}/enable|disable

# ---- 可选覆盖 ----
# OBSIDIAN_VAULT=/Users/linmintao/Documents/Obsidian Vault

# ============ 模型供应商只在 Dify 控制台配置（脚本不读取）============
# 当前激活上游 = Qwen3.8-Flash（2026-09-20 起），另有 DeepSeek 系 / GLM 系等备选 credential。
# 全部凭证已统一 max_tokens 16000 / context 131072，切换不会再撞 4096 上限。
# embedding（BAAI/bge-m3）在控制台配置后知识库自动可用。
