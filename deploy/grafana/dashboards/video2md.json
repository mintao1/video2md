{
  "title": "video2md 流水线",
  "uid": "video2md-main",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "tags": ["video2md"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "运行中 run",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "v2md_run_active", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value"}
    },
    {
      "id": 2, "type": "stat", "title": "排队 run",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "v2md_queue_queued", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value"}
    },
    {
      "id": 3, "type": "stat", "title": "熔断次数（窗口内）",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"expr": "sum(increase(v2md_circuit_breaker_trips_total[$__range]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value"}
    },
    {
      "id": 4, "type": "timeseries", "title": "run 终态（每窗口新增）",
      "description": "done/partial/error —— partial 意味着有条目失败（查 Langfuse trace 的 partial_failure 事件）",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"expr": "sum by (status) (increase(v2md_runs_total[$__interval]))", "legendFormat": "{{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}}, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5, "type": "timeseries", "title": "阶段平均耗时（秒）",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "sum by (stage) (rate(v2md_stage_seconds_sum[$__rate_interval])) / sum by (stage) (rate(v2md_stage_seconds_count[$__rate_interval]))", "legendFormat": "{{stage}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6, "type": "timeseries", "title": "LLM token 速率",
      "description": "精确成本在 Langfuse（generation 级）；这里看吞吐与趋势",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{"expr": "sum by (task, kind) (rate(v2md_llm_tokens_total[5m]))", "legendFormat": "{{task}}/{{kind}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7, "type": "timeseries", "title": "LLM 调用（每窗口，按终态）",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [{"expr": "sum by (task, status) (increase(v2md_llm_requests_total[$__interval]))", "legendFormat": "{{task}}/{{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars"}, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 8, "type": "timeseries", "title": "阶段条目结果（每窗口）",
      "description": "failed>0 = 部分失败留痕；skipped = state.json 幂等命中",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "targets": [{"expr": "sum by (stage, status) (increase(v2md_stage_entries_total[$__interval]))", "legendFormat": "{{stage}}/{{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars"}, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ]
}
