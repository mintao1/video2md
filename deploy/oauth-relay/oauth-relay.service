[Unit]
Description=Video2MD OAuth CONNECT relay
After=network-online.target
Wants=network-online.target

[Service]
Environment=V2PDF_OAUTH_RELAY_HOST=127.0.0.1
Environment=V2PDF_OAUTH_RELAY_ALLOWED_IPS=127.0.0.1
ExecStart=/usr/bin/python3 /opt/video2pdf-oauth-relay/relay.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
