[Unit]
Description=Video2MD OAuth local SSH tunnel from 4c to lcode-cn
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/ssh -N -i /etc/video2pdf/oauth-tunnel -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:18080:127.0.0.1:18080 root@43.135.164.222
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
